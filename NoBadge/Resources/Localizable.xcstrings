  "strings": {
    "1 second (default)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 second (default)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1초 (기본값)"
          }
        }
      }
    },
    "1. Open Privacy & Security → Full Disk Access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Open Privacy & Security → Full Disk Access."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 개인정보 보호 및 보안 → 전체 디스크 접근 권한을 여세요."
          }
        }
      }
    },
    "1. Open System Settings below.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Open System Settings below."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 아래에서 시스템 설정을 여세요."
          }
        }
      }
    },
    "10 seconds": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10 seconds"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10초"
          }
        }
      }
    },
    "2 seconds": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 seconds"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2초"
          }
        }
      }
    },
    "2. Add NoBadge from Applications and turn it on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Add NoBadge from Applications and turn it on."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 응용 프로그램의 NoBadge를 추가하고 켜세요."
          }
        }
      }
    },
    "3. Return here and check access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Return here and check access."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 이 화면으로 돌아와 접근 권한을 확인하세요."
          }
        }
      }
    },
    "3. Return here. Quit and reopen NoBadge if macOS asks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Return here. Quit and reopen NoBadge if macOS asks."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 여기로 돌아오세요. macOS가 요청하면 NoBadge를 종료 후 다시 여세요."
          }
        }
      }
    },
    "30 seconds": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 seconds"
          }
